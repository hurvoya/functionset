Moyenne clients par dealer =
CALCULATE(
    AVERAGEX(
        VALUES('Table'[Dealer]),
        CALCULATE(
            DISTINCTCOUNT('Table'[Client])
        )
    ),
    'Table'[Dealer sorti du suivi] = 1,
    USERELATIONSHIP(
        'Calendrier'[Date],
        'Table'[Date sortie du suivi]
    )
)


import pandas as pd

def analyse_market(df):

    # Copie pour ne pas modifier le DataFrame original
    df = df.copy()

    # Conversion de la date en datetime
    df["date trigger"] = pd.to_datetime(df["date trigger"], errors="coerce")

    # Création du mois-année
    df["mois"] = df["date trigger"].dt.to_period("M")

    # Identification des demandes LS Direct et TLS Direct
    df["is_direct"] = df["market"].isin(["LS direct", "TLS direct"])

    # Agrégation mensuelle
    result = (
        df.groupby("mois")
        .agg(
            nb_total_demandes=("numéro demande", "nunique"),
            nb_demandes_direct=("is_direct", "sum")
        )
        .reset_index()
    )

    # Calcul du ratio
    result["ratio_direct"] = (
        result["nb_demandes_direct"] / result["nb_total_demandes"] * 100
    ).round(2)

    return result

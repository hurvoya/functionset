df['Introsource identification Date'] = pd.to_datetime(
    df['Introsource identification Date'],
    dayfirst=True,
    errors='coerce'
)

df['Date sortie du suivi'] = (
    df['Introsource identification Date'] + pd.DateOffset(months=6)
)

df['Dealer sorti du suivi'] = (
    df['Date sortie du suivi'] <= pd.Timestamp.today()
).astype(int)

import pandas as pd

def calculate_completeness(df, country_col="Country"):
    # Colonnes à analyser, en excluant Country
    data_cols = [col for col in df.columns if col != country_col]

    # Calcul du taux de complétude par pays
    completeness = (
        df.groupby(country_col)[data_cols]
          .agg(lambda x: x.notna().mean() * 100)
    )

    # Une ligne par donnée et une colonne par pays
    return completeness.T.round(2)
